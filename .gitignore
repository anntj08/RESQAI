# Raw and derived geospatial data are not committed.
data/raw/**
data/processed/**
data/interim/gsi_pdf_text/
data/interim/table_review.txt

# Phase 3 working snapshots: full copies of data/processed/ and of the Phase 2 inventory
# products, kept only so a byte comparison can be run locally. Hundreds of MB of derived
# data that the pipeline can regenerate; the sha256 manifests they are compared against
# (data/file_inventory.csv, data/interim/p3/inventory_hashes_before.json) ARE committed.
data/interim/p3/rebuild_backup/
data/interim/p3/roundtrip_backup/
data/interim/p3/inventory_backup/

# Large binary formats, wherever they appear
*.tif
*.tiff
*.hgt
*.gz
*.zip
*.7z
*.gdb
*.gpkg
*.shp
*.dbf
*.shx
*.nc
*.h5

# Keep the small provenance artefacts
!data/file_inventory.csv
!data/interim/inventory_extracts/*.csv
!docs/*.csv

# Python
__pycache__/
*.pyc
.venv/
venv/

# Credentials — never commit
.netrc
_netrc
*.token
.env

# OS
Thumbs.db
desktop.ini
.DS_Store
