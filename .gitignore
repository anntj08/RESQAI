# Raw and derived geospatial data are not committed. Exception below: the Phase 4
# sampling tables (~600 KB text) are design/provenance products and ARE committed, like
# data/file_inventory.csv.
data/raw/**
data/processed/**
data/interim/gsi_pdf_text/
data/interim/table_review.txt

# Phase 4 sampling outputs are small text tables with real content to review; they
# must survive git history.
!data/processed/sampling/
!data/processed/sampling/**

# Phase 5 model artefacts: the feature table, JSON provenance/metrics and the PNG
# figures are small, reviewable and byte-reproducible, so they ARE committed. The
# joblib models and the susceptibility GeoTIFF stay local: they regenerate
# byte-identically from the committed scripts+config+data, and their sha256 is
# recorded in the committed metadata JSONs.
!data/processed/models/
!data/processed/models/**
data/processed/models/*.joblib
data/processed/models/*.tif

# Phase 3 working snapshots: full copies of data/processed/ and of the Phase 2 inventory
# products, kept only so a byte comparison can be run locally. Hundreds of MB of derived
# data that the pipeline can regenerate; the sha256 manifests they are compared against
# (data/file_inventory.csv, data/interim/p3/inventory_hashes_before.json) ARE committed.
data/interim/p3/rebuild_backup/
data/interim/p3/roundtrip_backup/
data/interim/p3/inventory_backup/

# Large binary formats, wherever they appear
*.tif
*.tiff
*.hgt
*.gz
*.zip
*.7z
*.gdb
*.gpkg
*.shp
*.dbf
*.shx
*.nc
*.h5

# RUN-2026-10-29-10: candidate-source assessment PDFs (~8.9 MB binary) kept as
# local review evidence in data/interim/inventory_source_review_2026-10-29/;
# the assessment JSONs, logs and CSV in that directory ARE committed.
data/interim/inventory_source_review_2026-10-29/*.pdf

# Keep the small provenance artefacts
!data/file_inventory.csv
!data/interim/inventory_extracts/*.csv
!docs/*.csv

# Python
__pycache__/
*.pyc
.venv/
venv/

# Credentials — never commit
.netrc
_netrc
*.token
.env

# OS
Thumbs.db
desktop.ini
.DS_Store
